@app.route('/', methods=['GET', 'POST'])
def login():
    erro = None
    if request.method == 'POST':
        email = request.form.get('email')
        senha = request.form.get('senha')
        plano = request.form.get('plano')
        if not email or not senha or not plano:
            erro = "Todos os campos são obrigatórios."
        else:
            usuarios[email] = {'senha': generate_password_hash(senha), 'plano': plano}
            session['usuario'] = email
            return redirect(url_for('dashboard'))
    return render_template_string(html_login, erro=erro)

@app.route('/dashboard', methods=['GET', 'POST'])
def dashboard():
    if 'usuario' not in session:
        return redirect(url_for('login'))
    email = session['usuario']
    plano = usuarios[email]['plano']
    resposta = None
    if request.method == 'POST':
        pergunta = request.form['mensagem']
        try:
            chat = openai.ChatCompletion.create(
                model='gpt-4o',
                messages=[
                    {"role": "system", "content": "Você é a IA Mettai, objetiva, prestativa e educada."},
                    {"role": "user", "content": pergunta}
                ]
            )
            resposta = chat.choices[0].message.content
        except:
            resposta = "Erro ao se comunicar com a IA."
    return render_template_string(html_dashboard, email=email, plano=plano, resposta=resposta)

@app.errorhandler(404)
def not_found(e):
    return render_template_string(html_404), 404

@app.errorhandler(500)
def internal_error(e):
